# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://befktpfqxurwfqtiaiqz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side Supabase configuration
SUPABASE_URL=https://befktpfqxurwfqtiaiqz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# REQUIRED on the server/Vercel only. Never expose this as VITE_*.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: comma-separated emails that should receive the server-side admin role.
# Never trust a role supplied by the browser.
ADMIN_EMAILS=
