# GEMINI_API_KEY: Primary AI engine (Gemini 3.8 Flash).
# (Also accepts: GOOGLE_API_KEY or VITE_GEMINI_API_KEY)
GEMINI_API_KEY="your-gemini-api-key-here"

# GROQ_API_KEY: High-speed secondary AI engine (LLaMA 3.3 70B Versatile).
# Automatically rolls up and falls back based on key availability and rate limits.
GROQ_API_KEY="your-groq-api-key-here"

# APP_URL: Optional base URL of your deployed application
APP_URL="https://your-domain.vercel.app"

# PORT: Optional port for local full-stack server (defaults to 3000)
PORT=3000

